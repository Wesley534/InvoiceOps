# Docker Compose configuration overrides for InvoiceOps.
# Copy to .env (next to docker-compose.yml) and adjust. Never commit secrets.

# Database: SQLite by default; point at your MySQL server for the hosted setup.
DATABASE_URL=sqlite:////data/invoiceops.db
# DATABASE_URL=mysql+pymysql://invoiceops:password@host:3306/invoiceops?charset=utf8mb4

# Auth secret. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Comma-separated frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# NVIDIA API (leave NVIDIA_API_KEY empty for deterministic-only mode).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEXT_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_VISION_MODEL=qwen/qwen2.5-vl-72b-instruct

# Host directory mounted read-only into the container at /data/master_data.
MASTER_DATA_HOST_DIR=../invoiceops-evaluation-dataset/master_data

# Seeded development users. The entrypoint runs the idempotent seed script on
# first start only (existing accounts are never overwritten), so set these to
# the approver/reviewer credentials you want provisioned on a fresh database.
SEED_REVIEWER_EMAIL=reviewer@invoiceops.dev
SEED_REVIEWER_NAME=Alex Reviewer
SEED_REVIEWER_PASSWORD=ReviewerPass2026
SEED_APPROVER_EMAIL=approver@invoiceops.dev
SEED_APPROVER_NAME=Jordan Approver
SEED_APPROVER_PASSWORD=ApproverPass2026
