# =============================================================================
# InvoiceOps backend configuration
# Copy to backend/.env and adjust. Never commit real secrets.
# All paths are resolved relative to the InvoiceOps project root (the parent
# of backend/), so the app works no matter which directory starts it.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=development            # development | test | production
DEBUG=true
LOG_LEVEL=INFO
# Optional rotating log file under InvoiceOps/var/logs (empty = console only)
LOG_FILE=

# --- Database ----------------------------------------------------------------
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./var/invoiceops.db
# MySQL (hosted option). The same schema and code, switch by this single var:
# DATABASE_URL=mysql+pymysql://invoiceops:invoiceops@127.0.0.1:3306/invoiceops?charset=utf8mb4
DB_ECHO=false

# --- Auth --------------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-random-48-byte-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- CORS --------------------------------------------------------------------
# Comma-separated allowlist of frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://invoiceops.netlify.app

# --- Storage -----------------------------------------------------------------
# Max accepted PDF upload size in megabytes.
MAX_UPLOAD_MB=25

# --- Master data & contracts (read-only inputs) ------------------------------
# Directory containing vendor_master.csv, purchase_orders.csv,
# goods_receipts.csv and processed_invoices.csv. Relative to project root.
MASTER_DATA_DIR=../invoiceops-evaluation-dataset/master_data
# Directory containing the JSON Schema contracts.
CONTRACTS_DIR=contracts

# --- NVIDIA API (LLM extraction repair / vision) -----------------------------
# Empty key = deterministic-only mode (still produces PASS/REVIEW/BLOCK, and
# REVIEW for documents that need AI help). OpenAI-compatible NVIDIA NIM.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEXT_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
LLM_TIMEOUT_SECONDS=120
LLM_RETRIES=2
LLM_TEMPERATURE=0.0

# --- Seeded users (dev only; run `python -m app.initial_data`) ---------------
SEED_REVIEWER_EMAIL=reviewer@invoiceops.dev
SEED_REVIEWER_PASSWORD=ReviewerPass2026
SEED_REVIEWER_NAME=Alex Reviewer
SEED_APPROVER_EMAIL=approver@invoiceops.dev
SEED_APPROVER_PASSWORD=ApproverPass2026
SEED_APPROVER_NAME=Jordan Approver
